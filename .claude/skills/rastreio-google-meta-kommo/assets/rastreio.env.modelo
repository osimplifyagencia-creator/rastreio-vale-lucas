# Rastreio Google e Meta até o Kommo: o que vem de fora (cliente, gestor de tráfego).
# O `rastreio.py plugar <slug>` copia este modelo para clientes/<slug>/rastreio.env (fora do git).
# Preencha só o valor depois do "=", sem aspas. Linha vazia = ainda não temos, e o `plugar` diz o que falta.
# O token do Kommo e a chave do n8n NÃO entram aqui: já estão em clientes/<slug>/.env e clientes/<slug>/n8n/.env.

# ---------------------------------------------------------------- MÓDULO 1: origem no Kommo
# Supabase do cliente. Preencha UM dos dois:
#   a chave service_role (Project Settings > API), e o plugar cria a credencial no n8n;
#   ou o id de uma credencial "Supabase API" que já existe no n8n do cliente.
SUPABASE_SERVICE_ROLE_KEY=
N8N_CRED_SUPABASE_ID=
# Token pessoal do Supabase com acesso ao projeto (supabase.com/dashboard/account/tokens).
# Só para aplicar o banco do rastreio pela API (`rastreio.py banco <slug>`). Sem ele, o SQL é colado no SQL Editor.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------- MÓDULO 2: venda de volta ao Google
# Conta do Google Ads (10 dígitos, com ou sem traço) e a conta de administrador (MCC), se o acesso for por ela.
GOOGLE_ADS_CONTA=
GOOGLE_ADS_CONTA_LOGIN=
# Id de cada ação de conversão do tipo "Importar de cliques", uma por evento do mapa de etapas do config
# (GOOGLE_ACAO_<EVENTO em maiúsculas>). Evento sem id não é enviado ao Google.
GOOGLE_ACAO_QUALIFICADO=
GOOGLE_ACAO_ORCAMENTO=
GOOGLE_ACAO_VENDA=
# A credencial do Google é OAuth e pede o clique em "Connect" no editor do n8n: crie lá (OAuth2 API genérica,
# escopo https://www.googleapis.com/auth/datamanager) e cole aqui o id dela.
N8N_CRED_GOOGLE_ID=

# ---------------------------------------------------------------- MÓDULO 2: venda de volta à Meta
# Dataset (pixel) no Gerenciador de Eventos, a conta do WhatsApp Business (WABA) e o token de usuário do sistema
# do MESMO Gerenciador de Negócios, com a permissão whatsapp_business_manage_events (token de outro
# gerenciador dá erro 100).
META_DATASET_ID=
META_WABA_ID=
META_SYSTEM_USER_TOKEN=
# Código de "Testar eventos" do dataset: com ele o envio desarmado aparece só na aba de teste.
META_TEST_EVENT_CODE=
